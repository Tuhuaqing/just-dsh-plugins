{
  "name": "dsh-auto-update",
  "version": "0.1.1",
  "description": "自动检测并更新 DeepSeek Harness（dsh）的插件：侧边栏显示当前版本，一键 npm install -g 更新并跨平台重启。",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tuhuaqing/just-dsh-plugins.git",
    "directory": "plugins/dsh-auto-update"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "scripts": {
    "prepublishOnly": "node --check index.js && node --check client.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "auto-update",
    "plugin"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
